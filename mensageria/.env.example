# Template de configuração — copie para .env e preencha os secrets

# Segurança (gerar com: python3 -c "import secrets; print(secrets.token_urlsafe(64))")
SECRET_KEY=CHANGE_ME

# Banco de dados (schema mensageria no Postgres existente)
DATABASE_URL=postgresql+asyncpg://evolution:CHANGE_ME@127.0.0.1:5432/evolution
DB_SCHEMA=mensageria

# Evolution API (container local)
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=CHANGE_ME

# Webhook inbound (endereço deste backend visto pelo container Evolution)
EDUFLOW_WEBHOOK_URL=http://localhost:3020/api/evolution/webhook

# CORS
CORS_ORIGINS=http://localhost:3000

# Diretório de mídia recebida via webhook
MEDIA_DIR=/home/ubuntu/mensageria/uploads

# Broadcast media (Fase 5.1)
MEDIA_ROOT=/var/lib/mensageria/media
MEDIA_MAX_BYTES=16777216

# Secret opcional para o webhook do Evolution / Meta
WEBHOOK_SECRET=

# WhatsApp oficial (Meta Cloud API)
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
META_ACCESS_TOKEN=
GRAPH_API_VERSION=v21.0

# Instagram Direct (app Meta SEPARADO do WhatsApp; reusa GRAPH_API_VERSION)
IG_APP_SECRET=
IG_WEBHOOK_VERIFY_TOKEN=

# Ponte Mensage <-> Customer (Sprint S1)
# Token que o Customer envia no header X-Service-Token (gerar: token_urlsafe(48))
SERVICE_TOKEN=
# Base URL do Customer pra onde o Mensage relaya inbound/status/progresso
CUSTOMER_RELAY_URL=https://cenatdata.online

# Agente de IA de vendas (PLANO_AGENTE.md)
OPENAI_API_KEY=
DOITY_TOKEN=

# MODO SANDBOX do agente — allowlist de contatos de teste.
# Números separados por vírgula, só dígitos com DDI (ex.: 5583999999999,5511888888888).
#
#   VAZIA      -> produção: gating normal (agent_enabled do canal + estado do contato).
#   NÃO-VAZIA  -> sandbox: o agente atende SOMENTE esses números. Para qualquer outro
#                 contato o comportamento é idêntico a agente desligado (sem resposta,
#                 sem sessão, sem log de turno). Isso permite ligar
#                 channels.agent_enabled=true no canal REAL de produção sem que nenhum
#                 cliente veja o agente.
#
# Vale para o inbound e para o envio de follow-up/boas-vindas. A conversão por polling
# da Doity continua registrando lead ganho e CAPI normalmente (é passiva, não envia
# mensagem) — só o envio das boas-vindas respeita a allowlist.
# O modo aparece no log de boot: "🧪 AGENT SANDBOX: N contato(s)" ou "🟢 AGENT PRODUÇÃO".
AGENT_TEST_WA_ALLOWLIST=

# Servidor
APP_HOST=0.0.0.0
APP_PORT=3020
APP_ENV=development
