# Template de configuração — copie para .env e preencha os secrets

# Segurança (gerar com: python3 -c "import secrets; print(secrets.token_urlsafe(64))")
SECRET_KEY=CHANGE_ME

# Banco de dados (schema mensageria no Postgres existente)
DATABASE_URL=postgresql+asyncpg://evolution:CHANGE_ME@127.0.0.1:5432/evolution
DB_SCHEMA=mensageria

# Evolution API (container local)
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=CHANGE_ME

# Webhook inbound (endereço deste backend visto pelo container Evolution)
EDUFLOW_WEBHOOK_URL=http://localhost:3020/api/evolution/webhook

# CORS
CORS_ORIGINS=http://localhost:3000

# Diretório de mídia recebida via webhook
MEDIA_DIR=/home/ubuntu/mensageria/uploads

# Broadcast media (Fase 5.1)
MEDIA_ROOT=/var/lib/mensageria/media
MEDIA_MAX_BYTES=16777216

# Secret opcional para o webhook do Evolution / Meta
WEBHOOK_SECRET=

# WhatsApp oficial (Meta Cloud API)
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
META_ACCESS_TOKEN=
GRAPH_API_VERSION=v21.0

# Instagram Direct (app Meta SEPARADO do WhatsApp; reusa GRAPH_API_VERSION)
IG_APP_SECRET=
IG_WEBHOOK_VERIFY_TOKEN=

# Ponte Mensage <-> Customer (Sprint S1)
# Token que o Customer envia no header X-Service-Token (gerar: token_urlsafe(48))
SERVICE_TOKEN=
# Base URL do Customer pra onde o Mensage relaya inbound/status/progresso
CUSTOMER_RELAY_URL=https://cenatdata.online

# Agente de IA de vendas (PLANO_AGENTE.md)
OPENAI_API_KEY=
DOITY_TOKEN=

# MODO SANDBOX do agente — allowlist de contatos de teste.
# Números separados por vírgula, só dígitos com DDI (ex.: 5583999999999,5511888888888).
#
#   VAZIA      -> produção: gating normal (agent_enabled do canal + estado do contato).
#   NÃO-VAZIA  -> sandbox: o agente atende SOMENTE esses números. Para qualquer outro
#                 contato o comportamento é idêntico a agente desligado (sem resposta,
#                 sem sessão, sem log de turno). Isso permite ligar
#                 channels.agent_enabled=true no canal REAL de produção sem que nenhum
#                 cliente veja o agente.
#
# Vale para o inbound e para o envio de follow-up/boas-vindas. A conversão por polling
# da Doity continua registrando lead ganho e CAPI normalmente (é passiva, não envia
# mensagem) — só o envio das boas-vindas respeita a allowlist.
# O modo aparece no log de boot: "🧪 AGENT SANDBOX: N contato(s)" ou "🟢 AGENT PRODUÇÃO".
AGENT_TEST_WA_ALLOWLIST=

# --- Agente de ATENDIMENTO ("Nat") ---
# A Nat é o perfil 'atendimento' do MESMO agente (app/agent/), não um app separado.
# Ela responde SOMENTE no canal cujo id está abaixo, e esse canal ainda precisa ser
# provider='evolution' com channels.agent_profile='atendimento' e agent_enabled=true.
# VAZIO/ausente -> Nat desligada em qualquer lugar. Nenhum outro canal Evolution
# (ex.: 9 "comunicados") responde, mesmo com agent_enabled=true.
AGENT_ATENDIMENTO_CHANNEL_ID=
#
# Sandbox PRÓPRIO do atendimento. Mesmo formato do AGENT_TEST_WA_ALLOWLIST (só dígitos
# com DDI, separados por vírgula) e mesma semântica: vazia = produção, não-vazia = só
# esses números. É INDEPENDENTE do sandbox de vendas — ligar este não coloca o canal 6
# em sandbox. ORDEM ao ativar: preencher aqui + restart ANTES de ligar o canal no banco.
AGENT_ATENDIMENTO_TEST_WA_ALLOWLIST=
#
# true (default) = quando um humano responde pelo painel ou pelo celular do número do
# atendimento, a IA pausa para aquele contato (contacts.ai_active=false); o botão do
# inbox devolve para a IA. O eco da própria mensagem da IA não dispara a pausa.
AGENT_ATENDIMENTO_PAUSE_ON_HUMAN=true
#
# Base de conhecimento da Nat (app/agent/kb/atendimento/*.md). Até este total de
# caracteres a base vai INTEIRA no system prompt; acima dele o modelo recebe só o
# índice e ganha a tool buscar_base (BM25 léxico, sem dependência nova).
AGENT_KB_INLINE_MAX_CHARS=15000
#
# Transcrição de voice note (áudio -> texto) no perfil ATENDIMENTO. Com false, quem manda
# áudio NÃO recebe resposta da IA (o agente nem é acordado) — a mensagem fica no inbox para
# a equipe. Vale SÓ para o perfil 'atendimento': o canal 6 de vendas ignora mídia como sempre.
# A Nat ouve áudio mas responde em TEXTO, de propósito: link, e-mail, data e valor precisam
# ser copiáveis e releríveis. Cobrado por minuto de áudio — confira o preço do modelo.
AGENT_AUDIO_TRANSCRIBE=true
OPENAI_MODEL_TRANSCRIBE=whisper-1
# Limite da API é 25 MB; áudio longo custa caro e demora mais que a paciência de quem espera.
AGENT_AUDIO_MAX_BYTES=20971520

# --- E-mail (Amazon SES) --- Etapa E4a. Runbook: docs/funis/EMAIL_SES.md
# Interruptor geral. false = módulo inerte (worker dorme, envio responde 409); SNS e descadastro seguem ativos.
EMAIL_ENABLED=false
# Sandbox: e-mails separados por vírgula. NÃO-vazia = só esses recebem (o resto vira skipped/sandbox). Vazia = produção.
EMAIL_TEST_ALLOWLIST=
# Taxa (envios/segundo) e cota (envios/24h) aplicadas pelo worker. Defaults = sandbox do SES; subir pelos valores do GetAccount.
EMAIL_RATE_PER_SECOND=1
EMAIL_DAILY_LIMIT=200
# Base pública dos links de descadastro (tem que ser a URL do nginx).
EMAIL_PUBLIC_BASE_URL=https://cenat.whatsflow.cloud
# Chave HMAC do token de descadastro (openssl rand -hex 32). Trocar invalida todos os links já enviados.
EMAIL_UNSUBSCRIBE_SECRET=
# Região do SES.
AWS_REGION=us-east-1
# Chave do usuário IAM mensage-ses (política mínima: SendEmail/SendRawEmail/GetAccount/GetEmailIdentity/ListEmailIdentities).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Remetente (identidade verificada no SES), nome de exibição e Reply-To padrão.
SES_FROM_EMAIL=
SES_FROM_NAME=CENAT
SES_REPLY_TO=
# Configuration set com event destination SNS (Send/Delivery/Bounce/Complaint/Reject).
SES_CONFIGURATION_SET=
# ARN do tópico SNS dos eventos; só este tópico tem a assinatura HTTPS confirmada automaticamente.
SES_SNS_TOPIC_ARN=

# Servidor
APP_HOST=0.0.0.0
APP_PORT=3020
APP_ENV=development
